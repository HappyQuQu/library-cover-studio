{
  "name": "library-cover-studio-backend",
  "version": "1.10.0",
  "description": "LibraryCoverStudio 后端 API 服务",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/copy-changelog.mjs",
    "start": "node dist/server.js",
    "clean": "rimraf dist node_modules",
    "lint": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@napi-rs/canvas": "^0.1.65",
    "adm-zip": "^0.5.16",
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "cron-parser": "^5.10.1",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.38.0",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "https-proxy-agent": "^7.0.6",
    "jsonrepair": "3.13.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.1.6",
    "node-cron": "^3.0.3",
    "openai": "^4.104.0",
    "p-limit": "^6.2.0",
    "saxes": "6.0.0",
    "sharp": "^0.33.5",
    "socks-proxy-agent": "^8.0.5",
    "uuid": "^11.0.0",
    "zod": "^3.24.0"
