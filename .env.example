# ==============================================
# LibraryCoverStudio 配置
# ==============================================

# 服务端口
PORT=3000
# Docker 对外端口（如有冲突可修改）
BACKEND_PORT=3000
WEB_PORT=8080

# 前端访问地址 (用于 CORS 配置)
FRONTEND_URL=http://localhost:5173

# 后端 API 访问基址 (用于生成图片代理路径)
BACKEND_URL=http://localhost:3000

# 敏感数据加密密钥 (建议修改为随机字符串)
ENCRYPTION_KEY=your-default-encryption-key-change-me

# JWT 配置 (用户登录验证)
JWT_SECRET=my-library-cover-secret-key
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# 并发限制
# 最大并发渲染数量
MAX_CONCURRENT_RENDERS=3
