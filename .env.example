# ==============================================
# LibraryCoverStudio 配置
# ==============================================

# 服务端口
PORT=3000
# Docker 网页端口（如有冲突可修改）；BACKEND_PORT 仅旧版双容器配置使用
BACKEND_PORT=3000
WEB_PORT=8080

# 前端访问地址 (用于 CORS 配置)
FRONTEND_URL=http://localhost:5173

# Vite 开发服务器的后端 API 代理目标
BACKEND_URL=http://localhost:3000

# 敏感数据加密密钥 (建议修改为随机字符串)
ENCRYPTION_KEY=your-default-encryption-key-change-me

# JWT 配置 (用户登录验证)
JWT_SECRET=my-library-cover-secret-key
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# 并发限制
# 最大并发渲染数量
MAX_CONCURRENT_RENDERS=3

# 可选：GitHub API 认证，仅需公开数据访问；设置页保存的 Token 优先
GITHUB_TOKEN=
