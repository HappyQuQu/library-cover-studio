{
  "name": "library-cover-studio",
  "version": "1.14.0",
  "description": "媒体库封面设计与自动化系统 - Jellyfin/Emby 海报美化专家",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "backend"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./web --filter ./backend dev",
    "dev:web": "pnpm --filter ./web dev",
    "dev:backend": "pnpm --filter ./backend dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter ./web build",
    "build:backend": "pnpm --filter ./backend build",
    "start": "pnpm --filter ./backend start",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "db:migrate": "pnpm --filter ./backend db:migrate",
    "db:seed": "pnpm --filter ./backend db:seed",
    "test": "pnpm --filter ./backend exec node ../scripts/test.mjs",
    "check:i18n": "pnpm --filter ./backend exec tsx ../scripts/i18n-check.ts",
    "dev:i18n-fixture": "node tests/fixtures/i18n-server.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.28.0"
}
