{
  "name": "library-cover-studio",
  "version": "1.0.0",
  "description": "Web-based poster designer and media library automation system",
  "private": true,
  "workspaces": [
    "web",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm run dev:web\" \"pnpm run dev:backend\"",
    "build": "pnpm run --recursive build",
    "start": "pnpm run --recursive start",
    "clean": "pnpm run --recursive clean && rm -rf node_modules",
    "lint": "pnpm run --recursive lint",
    "format": "pnpm run --recursive format",
    "test": "pnpm run --recursive test",
    "install:all": "pnpm install",
    "dev:web": "cd web && pnpm dev",
    "dev:backend": "cd backend && pnpm dev",
    "build:web": "cd web && pnpm build",
    "start:backend": "cd backend && pnpm start"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
